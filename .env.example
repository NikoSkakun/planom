# ── App Store Connect API Key ─────────────────────────────────────────────────
# Generate at: https://appstoreconnect.apple.com/access/integrations/api
# Role required: App Manager (or Admin)

# The short key ID shown on the API Keys page (e.g. "ABC1234DEF")
APP_STORE_CONNECT_API_KEY_ID=YOUR_KEY_ID

# The Issuer ID shown at the top of the API Keys page (UUID format)
APP_STORE_CONNECT_API_KEY_ISSUER_ID=YOUR_ISSUER_ID

# The full contents of the downloaded .p8 file, as a single line.
# Replace every real newline with the two characters \n before pasting into
# GitHub Secrets, e.g.:
#   -----BEGIN PRIVATE KEY-----\nMIGTA...\n-----END PRIVATE KEY-----
APP_STORE_CONNECT_API_KEY_CONTENT=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT\n-----END PRIVATE KEY-----
