# ── App Store Connect API Key ─────────────────────────────────────────────────
# Generate at: https://appstoreconnect.apple.com/access/integrations/api
# Role required: App Manager (or Admin)

# The short key ID shown on the API Keys page (e.g. "ABC1234DEF")
APP_STORE_CONNECT_API_KEY_ID=YOUR_KEY_ID

# The Issuer ID shown at the top of the API Keys page (UUID format)
APP_STORE_CONNECT_API_KEY_ISSUER_ID=YOUR_ISSUER_ID

# The full contents of the downloaded .p8 file, as a single line.
# Replace every real newline with the two characters \n before pasting into
# GitHub Secrets, e.g.:
#   -----BEGIN PRIVATE KEY-----\nMIGTA...\n-----END PRIVATE KEY-----
APP_STORE_CONNECT_API_KEY_CONTENT=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT\n-----END PRIVATE KEY-----


# ── Fastlane Match ────────────────────────────────────────────────────────────
# Match stores your certificates and provisioning profiles encrypted in a
# private Git repository. You create this repo once and never touch it manually.

# The encryption passphrase you chose when you ran `fastlane match init`
MATCH_PASSWORD=YOUR_MATCH_ENCRYPTION_PASSWORD

# SSH or HTTPS URL of the private Git repo used for certificate storage
# e.g. "https://github.com/your-org/ios-certificates.git"
MATCH_GIT_URL=https://github.com/YOUR_ORG/ios-certificates.git

# Base64-encoded "username:personal_access_token" for the certificates repo.
# Generate with: echo -n "github_username:ghp_yourtoken" | base64
# The token needs repo (read) scope on the certificates repo.
MATCH_GIT_BASIC_AUTHORIZATION=YOUR_BASE64_ENCODED_USER_COLON_TOKEN
