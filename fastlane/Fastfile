default_platform(:ios)

platform :ios do

  # ── Helpers ──────────────────────────────────────────────────────────────────

  def load_asc_api_key
    app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      # The .p8 content is stored as a single-line secret with literal \n characters.
      key_content:   ENV["APP_STORE_CONNECT_API_KEY_CONTENT"].gsub("\\n", "\n"),
      in_house:      false,
    )
  end

  # ── Lanes ─────────────────────────────────────────────────────────────────────

  desc "Build and upload a new beta to TestFlight"
  lane :beta do
    api_key = load_asc_api_key

    # app_store_connect_api_key with key_content: does not populate filepath.
    # Write the key to a temp file so xcodebuild -authenticationKeyPath works.
    require "tmpdir"
    key_path = File.join(Dir.tmpdir, "AuthKey_#{api_key[:key_id]}.p8")
    File.write(key_path, api_key[:key])

    # Bump the build number to the current timestamp (YYYYMMDDHHmmSS) so every
    # CI run produces a unique, monotonically increasing build number without
    # requiring a git commit.
    build_number = Time.now.strftime("%Y%m%d%H%M%S")
    increment_build_number(
      build_number: build_number,
      xcodeproj:    "ios/Runner.xcodeproj",
    )

    create_keychain(
      name:               "ci_build.keychain",
      password:           "ci_temp_pass",
      default_keychain:   true,
      unlock:             true,
      timeout:            3600,
      add_to_search_list: true,
    )

    # Fetch (or create on first run) the distribution certificate and
    # provisioning profile from the private certificates repo.
    # Match stores them encrypted; MATCH_PASSWORD is the decryption key.
    match(
      type:              "appstore",
      app_identifier:    "app.planom",
      git_url:           "https://x-access-token:#{ENV['MATCH_GITHUB_TOKEN']}@github.com/nikoskakun/ios-certificates",

      api_key:           api_key,
      keychain_name:     "ci_build.keychain",
      keychain_password: "ci_temp_pass",
    )

    build_app(
      workspace:      "ios/Runner.xcworkspace",
      scheme:         "Runner",
      configuration:  "Release",
      export_method:  "app-store",
      # Force manual signing on Runner. Pod targets are excluded from signing
      # via Podfile CODE_SIGNING_ALLOWED=NO, so this profile specifier only
      # affects Runner and won't bleed into pods.
      xcargs:         "CODE_SIGN_STYLE=Manual" \
                      " DEVELOPMENT_TEAM=GH6HRY4EWZ" \
                      " PROVISIONING_PROFILE_SPECIFIER='match AppStore app.planom'" \
                      " CODE_SIGN_IDENTITY='Apple Distribution'" \
                      " -authenticationKeyPath #{key_path}" \
                      " -authenticationKeyID #{api_key[:key_id]}" \
                      " -authenticationKeyIssuerID #{api_key[:issuer_id]}",
      output_directory: "build/ios/ipa",
      output_name:      "Planom.ipa",
      buildlog_path:    "build/ios/logs",
      silent:           is_ci,
    )

    upload_to_testflight(
      api_key:          api_key,
      ipa:              "build/ios/ipa/Planom.ipa",
      skip_submission:  true,
      skip_waiting_for_build_processing: false,
      changelog:        "Automated build from GitHub Actions — branch: #{ENV.fetch('GITHUB_REF_NAME', 'unknown')}",
    )

    # Distribute to the internal "Dev" group via direct Spaceship API call.
    # upload_to_testflight's `groups` param triggers post_beta_app_review_submission
    # (fastlane bug #28630), causing "Beta App Description is missing" errors.
    # Using Spaceship directly bypasses that broken code path entirely.
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id:    api_key[:key_id],
      issuer_id: api_key[:issuer_id],
      filepath:  key_path,
    )

    app = Spaceship::ConnectAPI::App.find("app.planom")
    UI.user_error!("Could not find app app.planom") unless app

    builds = Spaceship::ConnectAPI::Build.all(
      app_id:   app.id,
      version:  build_number,
      platform: "IOS",
    )
    build_obj = builds.first
    UI.user_error!("Build #{build_number} not found in ASC after upload") unless build_obj

    beta_group = app.get_beta_groups.find { |g| g.name == "Dev" }
    if beta_group
      build_obj.add_beta_groups(beta_groups: [beta_group])
      UI.success("✅  Build #{build_number} added to TestFlight group 'Dev'")
    else
      UI.important("⚠️  TestFlight group 'Dev' not found — build uploaded but not distributed")
    end

    UI.success("✅  Uploaded to TestFlight — build #{build_number}")
  end

end
