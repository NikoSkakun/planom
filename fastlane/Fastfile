default_platform(:ios)

# ── Constants ────────────────────────────────────────────────────────────────
APP_BUNDLE_ID    = "app.planom".freeze
WIDGET_BUNDLE_ID = "app.planom.PlanomWidget".freeze
APP_GROUP_ID     = "group.app.planom".freeze
TEAM_ID          = "GH6HRY4EWZ".freeze

platform :ios do

  # ── Helpers ──────────────────────────────────────────────────────────────────

  def load_asc_api_key
    app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      # The .p8 content is stored as a single-line secret with literal \n characters.
      key_content:   ENV["APP_STORE_CONNECT_API_KEY_CONTENT"].gsub("\\n", "\n"),
      in_house:      false,
    )
  end

  # Ensures the widget's App ID exists and that the App Groups capability +
  # the shared `group.app.planom` group are enabled/assigned on BOTH the app
  # and the widget App IDs. Without this, match-generated profiles won't carry
  # the `com.apple.security.application-groups` entitlement the widgets need.
  #
  # The App Store Connect API key can create Bundle IDs and toggle the
  # APP_GROUPS *capability*, but Apple does not expose App Group *entities* over
  # that API — creating/assigning the group itself needs Developer Portal
  # (Apple-ID) auth. We do as much as the key allows, then (if Apple-ID
  # credentials are present) finish the group via Spaceship::Portal. Every step
  # is best-effort + idempotent so re-runs are safe.
  def ensure_signing_prereqs(api_key, key_path)
    require "spaceship"

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id:    api_key[:key_id],
      issuer_id: api_key[:issuer_id],
      filepath:  key_path,
    )

    # 1. Make sure the widget extension's App ID exists.
    begin
      bundle_ids = Spaceship::ConnectAPI::BundleId.all
      unless bundle_ids.any? { |b| b.identifier == WIDGET_BUNDLE_ID }
        Spaceship::ConnectAPI::BundleId.create(
          name:       "Planom Widget",
          identifier: WIDGET_BUNDLE_ID,
          platform:   "IOS",
          seed_id:    TEAM_ID,
        )
        UI.success("Created App ID #{WIDGET_BUNDLE_ID}")
      end
    rescue => e
      UI.important("Widget App ID setup (match will retry): #{e.message}")
    end

    # 2. Enable the App Groups capability on both App IDs (idempotent).
    [APP_BUNDLE_ID, WIDGET_BUNDLE_ID].each do |bid|
      bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == bid }
      next unless bundle
      begin
        bundle.create_capability(
          Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS,
        )
        UI.success("Enabled App Groups capability on #{bid}")
      rescue => e
        UI.important("App Groups capability on #{bid} (likely already enabled): #{e.message}")
      end
    end

    # 3. Create + assign the actual App Group. Not available via the ASC API
    #    key, so this needs Apple-ID portal auth. Skip gracefully if absent.
    if ENV["FASTLANE_USER"].to_s.empty?
      UI.important("⚠️  No Apple-ID credentials (FASTLANE_USER) — skipping App Group creation/assignment.")
      UI.important("    If the build fails on the application-groups entitlement, create '#{APP_GROUP_ID}'")
      UI.important("    in the Developer Portal once and tick it on both '#{APP_BUNDLE_ID}' and '#{WIDGET_BUNDLE_ID}'.")
      return
    end

    begin
      Spaceship::Portal.login(ENV["FASTLANE_USER"], ENV["FASTLANE_PASSWORD"])
      Spaceship::Portal.client.team_id = TEAM_ID

      group = Spaceship::Portal.app_group.find(APP_GROUP_ID) ||
              Spaceship::Portal.app_group.create!(group_id: APP_GROUP_ID, name: "Planom Group")
      UI.success("App Group #{APP_GROUP_ID} ready")

      [APP_BUNDLE_ID, WIDGET_BUNDLE_ID].each do |bid|
        app = Spaceship::Portal.app.find(bid)
        next unless app
        app.update_service(Spaceship::Portal.app_service.app_group.on)
        app.associate_groups([group])
        UI.success("Associated #{bid} with #{APP_GROUP_ID}")
      end
    rescue => e
      UI.important("App Group portal setup skipped/failed: #{e.message}")
    end
  end

  # ── Lanes ─────────────────────────────────────────────────────────────────────

  desc "Build and upload a new beta to TestFlight"
  lane :beta do
    api_key = load_asc_api_key

    # app_store_connect_api_key with key_content: does not populate filepath.
    # Write the key to a temp file so xcodebuild -authenticationKeyPath works.
    require "tmpdir"
    key_path = File.join(Dir.tmpdir, "AuthKey_#{api_key[:key_id]}.p8")
    File.write(key_path, api_key[:key])

    # Bump the build number to the current timestamp (YYYYMMDDHHmmSS) so every
    # CI run produces a unique, monotonically increasing build number without
    # requiring a git commit.
    build_number = Time.now.strftime("%Y%m%d%H%M%S")
    increment_build_number(
      build_number: build_number,
      xcodeproj:    "ios/Runner.xcodeproj",
    )

    create_keychain(
      name:               "ci_build.keychain",
      password:           "ci_temp_pass",
      default_keychain:   true,
      unlock:             true,
      timeout:            3600,
      add_to_search_list: true,
    )

    # Make sure the widget App ID + App Groups capability/group exist before
    # match generates profiles, so the profiles carry the entitlement.
    ensure_signing_prereqs(api_key, key_path)

    # Fetch (or create on first run) the distribution certificate and
    # provisioning profiles for BOTH the app and the widget extension.
    # force: true regenerates profiles so newly-enabled capabilities (App
    # Groups) are baked into them. Match stores them encrypted in the certs
    # repo; MATCH_PASSWORD is the decryption key.
    match(
      type:              "appstore",
      app_identifier:    [APP_BUNDLE_ID, WIDGET_BUNDLE_ID],
      git_url:           "https://x-access-token:#{ENV['MATCH_GITHUB_TOKEN']}@github.com/nikoskakun/ios-certificates",
      api_key:           api_key,
      keychain_name:     "ci_build.keychain",
      keychain_password: "ci_temp_pass",
      force:             true,
    )

    # Apply manual signing per target. A single global PROVISIONING_PROFILE_
    # SPECIFIER can't serve two bundle IDs, so set each target's profile in the
    # project (CI workspace only) instead of via xcargs.
    update_code_signing_settings(
      path:                  "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id:               TEAM_ID,
      targets:               ["Runner"],
      bundle_identifier:     APP_BUNDLE_ID,
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore #{APP_BUNDLE_ID}",
    )
    update_code_signing_settings(
      path:                  "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id:               TEAM_ID,
      targets:               ["PlanomWidgetExtension"],
      bundle_identifier:     WIDGET_BUNDLE_ID,
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore #{WIDGET_BUNDLE_ID}",
    )

    build_app(
      workspace:      "ios/Runner.xcworkspace",
      scheme:         "Runner",
      configuration:  "Release",
      export_method:  "app-store",
      # Per-target profiles are set on the project above; here we only pass the
      # ASC API-key auth args. The export step maps each bundle ID to its
      # profile via export_options below.
      xcargs:         "-authenticationKeyPath #{key_path}" \
                      " -authenticationKeyID #{api_key[:key_id]}" \
                      " -authenticationKeyIssuerID #{api_key[:issuer_id]}",
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          APP_BUNDLE_ID    => "match AppStore #{APP_BUNDLE_ID}",
          WIDGET_BUNDLE_ID => "match AppStore #{WIDGET_BUNDLE_ID}",
        },
      },
      output_directory: "build/ios/ipa",
      output_name:      "Planom.ipa",
      buildlog_path:    "build/ios/logs",
      silent:           is_ci,
    )

    upload_to_testflight(
      api_key:          api_key,
      ipa:              "build/ios/ipa/Planom.ipa",
      skip_submission:  true,
      skip_waiting_for_build_processing: false,
      changelog:        "Automated build from GitHub Actions — branch: #{ENV.fetch('GITHUB_REF_NAME', 'unknown')}",
    )

    # Distribute to the internal "Dev" group via direct Spaceship API call.
    # upload_to_testflight's `groups` param triggers post_beta_app_review_submission
    # (fastlane bug #28630), causing "Beta App Description is missing" errors.
    # Using Spaceship directly bypasses that broken code path entirely.
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id:    api_key[:key_id],
      issuer_id: api_key[:issuer_id],
      filepath:  key_path,
    )

    app = Spaceship::ConnectAPI::App.find("app.planom")
    UI.user_error!("Could not find app app.planom") unless app

    # Build.all's `version:` param filters by marketing version (e.g. "1.0.0"),
    # NOT by build number. Omit it and find the right build by `b.version`,
    # which IS the build number (CFBundleVersion) on each Build object.
    build_obj = Spaceship::ConnectAPI::Build.all(
      app_id:   app.id,
      platform: "IOS",
    ).find { |b| b.version == build_number }
    UI.user_error!("Build #{build_number} not found in ASC after upload") unless build_obj

    beta_group = app.get_beta_groups.find { |g| g.name == "Dev" }
    if beta_group
      begin
        build_obj.add_beta_groups(beta_groups: [beta_group])
        UI.success("✅  Build #{build_number} added to TestFlight group 'Dev'")
      rescue => e
        UI.important("ℹ️  Group 'Dev' is internal — internal groups receive all builds automatically. (#{e.message})")
      end
    else
      UI.important("⚠️  TestFlight group 'Dev' not found — build uploaded but not distributed")
    end

    UI.success("✅  Uploaded to TestFlight — build #{build_number}")
  end

end
