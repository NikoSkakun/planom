default_platform(:ios)

platform :ios do

  # ── Helpers ──────────────────────────────────────────────────────────────────

  def load_asc_api_key
    app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      # The .p8 content is stored as a single-line secret with literal \n characters.
      key_content:   ENV["APP_STORE_CONNECT_API_KEY_CONTENT"].gsub("\\n", "\n"),
      in_house:      false,
    )
  end

  # ── Lanes ─────────────────────────────────────────────────────────────────────

  desc "Build and upload a new beta to TestFlight"
  lane :beta do
    api_key = load_asc_api_key

    # app_store_connect_api_key with key_content: does not populate filepath.
    # Write the key to a temp file so xcodebuild -authenticationKeyPath works.
    require "tmpdir"
    key_path = File.join(Dir.tmpdir, "AuthKey_#{api_key[:key_id]}.p8")
    File.write(key_path, api_key[:key])

    # Bump the build number to the current timestamp (YYYYMMDDHHmmSS) so every
    # CI run produces a unique, monotonically increasing build number without
    # requiring a git commit.
    build_number = Time.now.strftime("%Y%m%d%H%M%S")
    increment_build_number(
      build_number: build_number,
      xcodeproj:    "ios/Runner.xcodeproj",
    )

    # Set up a temporary keychain for certificate import.
    keychain_name     = "ci_build.keychain"
    keychain_password = "ci_temp_pass"
    create_keychain(
      name:               keychain_name,
      password:           keychain_password,
      default_keychain:   true,
      unlock:             true,
      timeout:            3600,
      add_to_search_list: true,
    )

    # Revoke all existing iOS Distribution certificates via the ASC API so
    # cert can always create a fresh one without hitting the 2-cert limit.
    # app_store_connect_api_key above already configured Spaceship's auth.
    existing = Spaceship::ConnectAPI::Certificate.all(
      filter: { certificateType: "IOS_DISTRIBUTION" },
    )
    existing.each do |c|
      UI.message("Revoking distribution certificate #{c.id}...")
      c.delete!
    end

    cert(
      api_key:           api_key,
      keychain_path:     "~/Library/Keychains/#{keychain_name}-db",
      keychain_password: keychain_password,
      output_path:       Dir.tmpdir,
    )

    # Register the App ID via the ASC Connect API (uses the api_key already
    # configured above — no Apple ID password required, unlike produce).
    begin
      Spaceship::ConnectAPI::BundleId.create(
        name:      "Planom",
        identifier: "app.planom",
        platform:   "IOS",
      )
      UI.message("Registered App ID app.planom")
    rescue => e
      UI.message("App ID app.planom already exists (#{e.message})")
    end

    # Fetch or create the App Store distribution provisioning profile.
    sigh(
      api_key:           api_key,
      app_identifier:    "app.planom",
      provisioning_name: "Planom App Store",
      force:             true,
      output_path:       Dir.tmpdir,
    )

    # -allowProvisioningUpdates lets xcodebuild pick up the profile created above.
    build_app(
      workspace:      "ios/Runner.xcworkspace",
      scheme:         "Runner",
      configuration:  "Release",
      export_method:  "app-store",
      xcargs:         "-allowProvisioningUpdates" \
                      " -authenticationKeyPath #{key_path}" \
                      " -authenticationKeyID #{api_key[:key_id]}" \
                      " -authenticationKeyIssuerID #{api_key[:issuer_id]}",
      output_directory: "build/ios/ipa",
      output_name:      "Planom.ipa",
      buildlog_path:    "build/ios/logs",
      silent:           is_ci,
    )

    # Create the App Store Connect app record if it doesn't exist yet.
    # BundleId.create above only registers the bundle ID in the Developer Portal;
    # upload_to_testflight requires a full ASC app record.
    begin
      Spaceship::ConnectAPI::App.create(
        name:           "Planom",
        version_string: "1.0",
        sku:            "app-planom-001",
        primary_locale: "en-US",
        bundle_id:      "app.planom",
        platforms:      ["IOS"],
      )
      UI.message("Created App Store Connect app record for app.planom")
    rescue => e
      UI.message("App Store Connect app record already exists (#{e.message})")
    end

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               "build/ios/ipa/Planom.ipa",
      skip_waiting_for_build_processing: true,
      changelog:                         "Automated build from GitHub Actions — branch: #{ENV.fetch('GITHUB_REF_NAME', 'unknown')}",
    )

    UI.success("✅  Uploaded to TestFlight — build #{build_number}")
  end

end
